{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cnn-turk-browser-test",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "MYBROWSER" },
  "kv_namespaces": [ { "binding": "STREAMS_KV" } ],
  "triggers": { "crons": [ "11 * * * *" ] }
}
